<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the app collects, and which of Apple's "required reason" APIs it touches.

  Two separate jobs, and both are needed:

    * `NSPrivacyCollectedDataTypes` has to say the same thing as the App Privacy
      section of the App Store listing and as `site/privacy.html`. Three answers
      to one question is three chances to disagree, which is a rejection.
    * `NSPrivacyAccessedAPITypes` has to declare the APIs whose use Apple
      requires a reason for, or the upload is bounced with ITMS-91053. This app
      uses exactly one: `UserDefaults`, through `@AppStorage`, for the player's
      own preferences. It does not read file timestamps, boot time, disk space or
      the keyboard list — checked rather than assumed: `grep -rlE
      'attributesOfItem|systemUptime|volumeAvailableCapacity|activeInputModes'
      Sources/` returns nothing.

  There is no tracking here at all, which is why `NSPrivacyTracking` is false,
  `NSPrivacyTrackingDomains` is empty, and the analytics are built without the
  advertising identifier (`FirebaseAnalyticsWithoutAdIdSupport` in project.yml).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The analytics installation identifier. Not linked to a person: there
		     are no accounts, and nothing here identifies anybody. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- Which games were played, solo or shared, how they ended and which
		     screens were opened. Counts, never the words anybody used. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!-- Crashlytics: what the app was doing when it broke, with the device
		     model and iOS version. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The note somebody writes in the feedback box. It becomes an issue on
		     a public repository, which the support page says outright. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCustomerSupport</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- The nickname, kept on the device and written into the room so the
		     other players can see whose turn it is. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: reading and writing the app's own defaults, which
				     nothing outside the app can see. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
