# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details
# Get these values from: Firebase Console > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# App Check Configuration (REQUIRED for security)
# Get this from: Firebase Console > App Check > Your web app
# This is your reCAPTCHA v3 site key
VITE_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_site_key_here

# Analytics (OPTIONAL)
# Get this from: Firebase Console > Project settings > Integrations, once Google
# Analytics is enabled for the project. It is the web data stream's `G-…` value.
# Leave it blank and the site works exactly as before: with no id, the Analytics
# library is never even downloaded. See src/analytics.ts.
VITE_FIREBASE_MEASUREMENT_ID=

