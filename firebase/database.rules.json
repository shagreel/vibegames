{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$gameId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['word', 'creator', 'createdAt'])",
        "word": {
          ".write": "!data.exists() || data.parent().child('winner').exists()",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{5}$/)"
        },
        "creator": {
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
        },
        "createdAt": {
          ".write": "!data.exists()",
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
        },
        "started": {
          ".write": true,
          ".validate": "newData.isBoolean()"
        },
        "winner": {
          ".write": "!data.child('name').exists() || newData.val() === null",
          ".validate": "newData.val() === null || newData.hasChildren(['name', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "restartTime": {
          ".write": true,
          ".validate": "newData.isNumber() || newData.val() === null"
        },
        "players": {
          ".write": true,
          "$playerId": {
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().matches(/^.{1,24}$/) && newData.child('joinedAt').isNumber()",
            "name": {
              ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "sudoku": {
      "$gameId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['seed', 'difficulty', 'creator', 'createdAt'])",
        "seed": {
          ".write": "!data.exists() || data.parent().child('winner').exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 4294967296 && newData.val() % 1 === 0"
        },
        "difficulty": {
          ".write": "!data.exists() || data.parent().child('winner').exists()",
          ".validate": "newData.val() === 'easy' || newData.val() === 'medium' || newData.val() === 'hard'"
        },
        "creator": {
          ".write": "!data.exists()",
          ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
        },
        "createdAt": {
          ".write": "!data.exists()",
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
        },
        "started": {
          ".write": true,
          ".validate": "newData.isBoolean()"
        },
        "winner": {
          ".write": "!data.child('name').exists() || newData.val() === null",
          ".validate": "newData.val() === null || newData.hasChildren(['name', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "restartTime": {
          ".write": true,
          ".validate": "newData.isNumber() || newData.val() === null"
        },
        "players": {
          ".write": true,
          "$playerId": {
            ".validate": "newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().matches(/^.{1,24}$/) && newData.child('joinedAt').isNumber()",
            "name": {
              ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "trio": {
      "$gameId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['meta'])",
        "meta": {
          ".validate": "newData.hasChildren(['seed', 'creator', 'createdAt'])",
          "seed": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 4294967296 && newData.val() % 1 === 0"
          },
          "creator": {
            ".write": "!data.exists()",
            ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
          },
          "createdAt": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "started": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          },
          "restartTime": {
            ".write": true,
            ".validate": "newData.isNumber() || newData.val() === null"
          },
          "$other": {
            ".validate": false
          },
          "hints": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          }
        },
        "players": {
          "$playerId": {
            ".write": true,
            ".validate": "newData.val() === null || newData.val() === true"
          }
        },
        "taken": {
          ".write": true,
          "$cardId": {
            ".validate": "newData.val() === null || ((!data.exists() || (newData.child('seq').val() === data.child('seq').val() && newData.child('by').val() === data.child('by').val() && newData.child('name').val() === data.child('name').val())) && newData.hasChildren(['seq', 'by', 'name']))",
            "seq": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "by": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,16}$/)"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "feedback": {
      ".read": true,
      "$entryId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['text', 'source', 'createdAt'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 2000"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().matches(/^(ios|web)$/)"
        },
        "game": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 40)"
        },
        "kind": {
          ".validate": "newData.val() === null || newData.val() === 'feedback' || newData.val() === 'crash'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 86400000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "blurt": {
      "$gameId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['meta'])",
        "meta": {
          ".validate": "newData.hasChildren(['seed', 'creator', 'createdAt'])",
          "seed": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 4294967296 && newData.val() % 1 === 0"
          },
          "creator": {
            ".write": "!data.exists()",
            ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
          },
          "createdAt": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "started": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          },
          "turnSeconds": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 600"
          },
          "packs": {
            ".write": true,
            "$pack": {
              ".validate": "newData.val() === true && $pack.matches(/^(food|animals|places|household|people|play|actions|occasions)$/)"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$playerId": {
            ".write": true,
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 24)"
          }
        },
        "teams": {
          ".write": true,
          "$playerId": {
            ".write": true,
            ".validate": "newData.val() === null || newData.val() === 1 || newData.val() === 2"
          }
        },
        "play": {
          ".write": true,
          ".validate": "newData.hasChildren(['round', 'turn', 'team', 'describer', 'word', 'state', 'one', 'two'])",
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "turn": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "team": {
            ".validate": "newData.val() === 1 || newData.val() === 2"
          },
          "describer": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,16}$/)"
          },
          "word": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "state": {
            ".validate": "newData.val() === 'ready' || newData.val() === 'running' || newData.val() === 'ended'"
          },
          "startedAt": {
            ".validate": "newData.val() === null || newData.isNumber()"
          },
          "endsAt": {
            ".validate": "newData.val() === null || newData.isNumber()"
          },
          "reason": {
            ".validate": "newData.val() === null || newData.val() === 'time' || newData.val() === 'blurt'"
          },
          "scorer": {
            ".validate": "newData.val() === null || newData.val() === 1 || newData.val() === 2"
          },
          "one": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          },
          "two": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          },
          "finished": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "ten": {
      "$gameId": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['meta'])",
        "meta": {
          ".validate": "newData.hasChildren(['seed', 'creator', 'createdAt'])",
          "seed": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 4294967296 && newData.val() % 1 === 0"
          },
          "creator": {
            ".write": "!data.exists()",
            ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
          },
          "createdAt": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "started": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          },
          "restartTime": {
            ".write": true,
            ".validate": "newData.isNumber() || newData.val() === null"
          },
          "columns": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 6 && newData.val() <= 9 && newData.val() % 1 === 0"
          },
          "rows": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && newData.val() >= 12 && newData.val() <= 18 && newData.val() % 1 === 0"
          },
          "rowsPerAdd": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber() && (newData.val() === 2 || newData.val() === 4)"
          },
          "difficulty": {
            ".write": "!data.exists()",
            ".validate": "newData.val() === 'easy' || newData.val() === 'medium' || newData.val() === 'hard'"
          },
          "wrap": {
            ".write": "!data.exists()",
            ".validate": "newData.isBoolean()"
          },
          "mode": {
            ".write": "!data.exists()",
            ".validate": "newData.val() === 'remove' || newData.val() === 'dim'"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$playerId": {
            ".write": true,
            ".validate": "newData.val() === null || newData.hasChildren(['name', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().matches(/^.{1,24}$/)"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "scores": {
          "$playerId": {
            ".write": true,
            ".validate": "newData.val() === null || newData.hasChildren(['score'])",
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
            },
            "finishedAt": {
              ".validate": "newData.isNumber() || newData.val() === null"
            },
            "clearedAt": {
              ".validate": "newData.isNumber() || newData.val() === null"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
